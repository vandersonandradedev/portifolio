# ─── Local: copie para .env.local ───
# cp .env.example .env.local

# GitHub — OBRIGATÓRIO em dev se bater rate limit (403)
# Crie em: https://github.com/settings/tokens (classic, só permissão public_repo ou sem scopes)
# Em produção: Vercel → Settings → Environment Variables → GITHUB_TOKEN
GITHUB_TOKEN=

# Upstash Redis — opcional em local (sem isso, curtidas/views ficam no localStorage)
# Vercel Dashboard → Storage → Redis → Connect
KV_REST_API_URL=
KV_REST_API_TOKEN=
